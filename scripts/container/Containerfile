# Linux build/test image for GRID Launcher (Ubuntu 24.04, the same distribution as the
# GitHub Linux jobs, so the apt package names are the ones in BUILD.md and build.yml).
# Built by `scripts/ctr.sh build`. The build context is this folder only, so the repo
# is never sent to the builder.
FROM docker.io/library/ubuntu:24.04

ARG RUST_TOOLCHAIN=stable
ARG NODE_MAJOR=22

# APPIMAGE_EXTRACT_AND_RUN: the Tauri AppImage bundler runs linuxdeploy, itself an
# AppImage; there is no FUSE in the container, so AppImages extract themselves instead.
ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/opt/node/bin:$PATH \
    APPIMAGE_EXTRACT_AND_RUN=1

# Base tools, the Tauri 2 Linux libraries (BUILD.md "Prerequisites"), the end-to-end
# harness (xvfb … sqlite3) and the AppImage bundle tools (file, patchelf, zsync).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git xz-utils zip unzip file patchelf zsync procps \
      pkg-config build-essential cmake libssl-dev \
      libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev \
      xvfb xauth gnome-keyring libsecret-tools dbus-x11 at-spi2-core sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Node (official tarball from nodejs.org, checksum verified).
RUN set -eux; cd /tmp; \
    curl -fsSLO "https://nodejs.org/dist/latest-v${NODE_MAJOR}.x/SHASUMS256.txt"; \
    f=$(grep -o "node-v[0-9.]*-linux-x64.tar.xz" SHASUMS256.txt | head -1); \
    curl -fsSLO "https://nodejs.org/dist/latest-v${NODE_MAJOR}.x/$f"; \
    grep " $f\$" SHASUMS256.txt | sha256sum -c -; \
    mkdir -p /opt/node && tar -xJf "$f" -C /opt/node --strip-components=1; \
    rm -f "$f" SHASUMS256.txt; node --version

# Rust via rustup, with the components the gate uses. rustup's proxies live in
# CARGO_HOME (/opt/cargo); only its registry/ and git/ subfolders are runtime volumes.
RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none --no-modify-path; \
    rustup toolchain install "${RUST_TOOLCHAIN}" --profile minimal -c rustfmt -c clippy; \
    rustup default "${RUST_TOOLCHAIN}"; \
    mkdir -p /opt/cargo/registry /opt/cargo/git; chmod -R a+rwX /opt/rustup /opt/cargo

ENV HOME=/home/ctr
RUN mkdir -p /home/ctr && chmod 1777 /home/ctr
WORKDIR /work
