# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Build and packaging artifacts
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Generated at build time from git describe
grid_launcher/version.py

# Tool caches and coverage artifacts
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
User/
unittest_*

# Logs
*.log
pytest_*
*.sync-conflict-*

# IDE and editor user files
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
*.code-workspace

# OS-generated files
.DS_Store
Thumbs.db

# Ignore the agents and related files
agents/
skills/

#graphify
graphify-out/
.graphify-out/

# AppImage build artifacts
AppDir/
appimagetool
# Generated by build.sh from assets/svg/io.github.Sixdd6.GRIDLauncher.svg
appimage/grid-launcher.png

# Rust rewrite
rewrite/target/
rewrite/app/node_modules/
rewrite/app/dist/
rewrite/e2e/node_modules/

# E2E mock server debugging artifacts: written by mock-romm's close(), and
# appended live by mock-forge as requests arrive
rewrite/e2e/last-run-requests.log
rewrite/e2e/last-run-forge-requests.log

# Superpowers scratch (SDD ledgers, brainstorm mockups)
.superpowers/
